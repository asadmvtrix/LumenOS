{
  "name": "lumen-os",
  "version": "1.0.0",
  "description": "LumenOS — a portable browser-based desktop OS",
  "main": "main.js",
  "author": "Asad",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "make-icon": "node scripts/make-icon.js",
    "build": "npm run make-icon && electron-builder --win portable --x64",
    "build:installer": "npm run make-icon && electron-builder --win nsis --x64",
    "build:both": "npm run make-icon && electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.asad.lumenos",
    "productName": "LumenOS",
    "copyright": "© 2026 Asad",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "vercel.json",
      "!node_modules/**/*",
      "!dist/**/*",
      "!.claude/**/*"
    ],
    "win": {
      "icon": "assets/lumen.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LumenOS.exe"
    },
    "portable": {
      "artifactName": "LumenOS.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LumenOS",
      "artifactName": "LumenOS-Setup.exe"
    }
  }
}
